---
import { url } from '../utils/paths';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Monte da Colónia | Vinhos e Azeites de Excelência do Alentejo",
  description = "Tradição familiar, vinhas de excelência e azeites virgem extra premium no Vale de Seda, Fronteira, Alto Alentejo."
} = Astro.props;
---

<!doctype html>
<html lang="pt" class="scroll-smooth overflow-x-hidden w-full max-w-[100vw]">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <link rel="icon" type="image/png" href={url('favicon.png')} />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>

    <!-- Google Fonts: Cinzel + Cormorant Garamond + Playfair Display + Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700&family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&display=swap" rel="stylesheet">

    <style is:global>
      /* Absolute Mobile Horizontal Lock: Prevents any side-scrolling, drag, or wobble */
      html, body {
        overflow-x: hidden !important;
        max-width: 100vw !important;
        width: 100% !important;
        position: relative;
        touch-action: pan-y;
        -webkit-overflow-scrolling: touch;
      }

      /* Prevent media from causing overflow */
      img, video, canvas, svg {
        max-width: 100%;
      }
    </style>
  </head>
  <body class="bg-[#FAF8F5] text-[#2B231D] font-sans antialiased selection:bg-[#C5A059] selection:text-white min-h-screen flex flex-col overflow-x-hidden w-full max-w-[100vw] relative">
    <slot />
  </body>
</html>
