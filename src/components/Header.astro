---
import { url } from '../utils/paths';

interface Props {
  currentPage?: 'monte' | 'produtos' | 'visitas' | 'contactos' | 'loja';
  isStore?: boolean;
}

const { currentPage = '', isStore = false } = Astro.props;
---

<header class="fixed top-0 left-0 right-0 z-50 bg-[#14100D] shadow-2xl transition-all duration-300">
  <div class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between">
    
    <!-- Brand Identity with Gold House Emblem -->
    <a href={url()} class="flex items-center gap-3.5 group" title="Voltar ao Portal Monte da Colónia">
      <img 
        src={url('assets/logos/logo_house_gold.png')} 
        alt="Monte da Colónia" 
        class="h-10 sm:h-11 w-auto object-contain filter drop-shadow-[0_2px_8px_rgba(243,208,138,0.35)] group-hover:scale-105 transition-transform duration-300" 
      />
      <div class="flex flex-col text-left">
        <span class="font-cinzel text-xs sm:text-sm font-semibold tracking-[0.28em] uppercase text-[#F3D08A] group-hover:text-[#FFF4D4] transition-colors">
          Monte da Colónia
        </span>
        <span class="font-cinzel text-[9px] tracking-[0.32em] uppercase text-stone-400 mt-0.5">
          Vale de Seda · 1980
        </span>
      </div>
    </a>

    <!-- Desktop Navigation: Strictly Content Pages (No Loja Online in Menu List) -->
    <nav class="hidden md:flex items-center gap-7 lg:gap-8 text-xs font-cinzel uppercase tracking-[0.22em]">
      <a 
        href={url('monte')} 
        class={`transition-colors py-1 ${currentPage === 'monte' ? 'text-[#F3D08A] font-semibold border-b border-[#C5A059]' : 'text-stone-300 hover:text-[#F3D08A]'}`}
      >
        O Monte
      </a>
      <a 
        href={url('produtos')} 
        class={`transition-colors py-1 ${currentPage === 'produtos' ? 'text-[#F3D08A] font-semibold border-b border-[#C5A059]' : 'text-stone-300 hover:text-[#F3D08A]'}`}
      >
        Produtos
      </a>
      <a 
        href={url('visitas')} 
        class={`transition-colors py-1 ${currentPage === 'visitas' ? 'text-[#F3D08A] font-semibold border-b border-[#C5A059]' : 'text-stone-300 hover:text-[#F3D08A]'}`}
      >
        Visitas
      </a>
      <a 
        href={url('contactos')} 
        class={`transition-colors py-1 ${currentPage === 'contactos' ? 'text-[#F3D08A] font-semibold border-b border-[#C5A059]' : 'text-stone-300 hover:text-[#F3D08A]'}`}
      >
        Contactos
      </a>
    </nav>

    <!-- Header Actions / CTA Button Area -->
    <div class="flex items-center gap-3">
      {isStore ? (
        <!-- On Store page: Cart drawer trigger -->
        <button 
          id="open-cart-btn" 
          class="relative px-5 sm:px-6 py-2.5 border border-[#C5A059]/70 hover:border-[#F3D08A] bg-[#221A14] hover:bg-[#F3D08A] text-[#F3D08A] hover:text-[#14100D] font-cinzel text-[11px] sm:text-xs uppercase tracking-[0.22em] font-semibold shadow-md hover:shadow-[#F3D08A]/25 transition-all duration-300 flex items-center gap-2.5 cursor-pointer"
          title="Ver Carrinho de Compras"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path>
          </svg>
          <span>Carrinho</span>
          <span id="header-cart-badge" class="w-5 h-5 flex items-center justify-center bg-[#C5A059] text-stone-950 font-sans font-bold text-[11px] leading-none">0</span>
        </button>
      ) : (
        <!-- Standard CTA across all pages: Loja Online -->
        <a 
          href={url('loja')} 
          class="px-5 sm:px-6 py-2.5 border border-[#C5A059]/70 hover:border-[#F3D08A] bg-[#221A14] hover:bg-[#F3D08A] text-[#F3D08A] hover:text-[#14100D] font-cinzel text-[11px] sm:text-xs uppercase tracking-[0.22em] font-semibold shadow-md hover:shadow-[#F3D08A]/25 transition-all duration-300"
        >
          Loja Online
        </a>
      )}

      <!-- Mobile Menu Hamburger Button -->
      <button 
        id="mobile-menu-toggle"
        class="md:hidden p-2 text-stone-300 hover:text-[#F3D08A] focus:outline-none"
        aria-label="Abrir Menu"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path id="hamburger-icon" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          <path id="close-icon" class="hidden" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>

  </div>

  <!-- Mobile Dropdown Menu -->
  <div id="mobile-menu" class="hidden md:hidden bg-[#14100D]/98 border-t border-[#C5A059]/30 px-6 py-6 transition-all duration-300">
    <nav class="flex flex-col gap-4 text-sm font-cinzel uppercase tracking-[0.22em]">
      <a 
        href={url('monte')} 
        class={`py-1.5 transition-colors ${currentPage === 'monte' ? 'text-[#F3D08A] font-semibold' : 'text-stone-300 hover:text-[#F3D08A]'}`}
      >
        O Monte
      </a>
      <a 
        href={url('produtos')} 
        class={`py-1.5 transition-colors ${currentPage === 'produtos' ? 'text-[#F3D08A] font-semibold' : 'text-stone-300 hover:text-[#F3D08A]'}`}
      >
        Produtos
      </a>
      <a 
        href={url('visitas')} 
        class={`py-1.5 transition-colors ${currentPage === 'visitas' ? 'text-[#F3D08A] font-semibold' : 'text-stone-300 hover:text-[#F3D08A]'}`}
      >
        Visitas
      </a>
      <a 
        href={url('contactos')} 
        class={`py-1.5 transition-colors ${currentPage === 'contactos' ? 'text-[#F3D08A] font-semibold' : 'text-stone-300 hover:text-[#F3D08A]'}`}
      >
        Contactos
      </a>
      <div class="pt-4 mt-2 border-t border-stone-800">
        <a 
          href={url('loja')} 
          class="block text-center py-3 border border-[#F3D08A] bg-[#221A14] text-[#F3D08A] font-cinzel text-xs uppercase tracking-[0.25em] font-semibold"
        >
          Loja Online Oficial
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const hamburgerIcon = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');

  if (toggleBtn && mobileMenu && hamburgerIcon && closeIcon) {
    toggleBtn.addEventListener('click', () => {
      const isExpanded = !mobileMenu.classList.contains('hidden');
      if (isExpanded) {
        mobileMenu.classList.add('hidden');
        hamburgerIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
      } else {
        mobileMenu.classList.remove('hidden');
        hamburgerIcon.classList.add('hidden');
        closeIcon.classList.remove('hidden');
      }
    });
  }
</script>
