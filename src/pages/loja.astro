---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { Image } from 'astro:assets';
import imgVinha from '../assets/real_candidates/real-01-vinha-panorama.jpg';

const b = import.meta.env.BASE_URL;

// Products Catalog
const products = [
  // VINHOS
  {
    id: "vinho-reserva-tinto",
    category: "vinhos",
    name: "Monte da Colónia Reserva Tinto 2023",
    subtitle: "Alicante Bouschet, Touriga Nacional & Syrah",
    specs: "750 ml · 14.5% Vol · 12 Meses Barrica",
    price: 19.50,
    badge: "Ouro Anuga",
    image: `${b}assets/products/Reserva2023.jpeg`,
    description: "Cor granada profunda, notas de amoras silvestres, esteva e carvalho francês de Allier. Final longo e aveludado."
  },
  {
    id: "vinho-colheita-branco",
    category: "vinhos",
    name: "Colheita Selecionada Branco 2024",
    subtitle: "Antão Vaz, Arinto & Fernão Pires",
    specs: "750 ml · 13.0% Vol · Fermentação a Frio",
    price: 11.50,
    badge: "Nova Colheita",
    image: `${b}assets/products/Colheita-Selecionada-2024.jpeg`,
    description: "Luminoso e mineral, aroma cítrico a lima madura e flor de laranjeira. Acidez tensa e refrescante."
  },
  {
    id: "vinho-rose-touriga",
    category: "vinhos",
    name: "Touriga Nacional Rosé 2024",
    subtitle: "100% Touriga Nacional de Vale de Seda",
    specs: "750 ml · 12.5% Vol · Prensagem Suave",
    price: 12.00,
    badge: "Elegância",
    image: `${b}assets/products/Rouriga-Rose-2024.jpeg`,
    description: "Rosa pálido com notas de romã fresca e framboesa silvestre. Frescura crocante e final mineral."
  },
  {
    id: "vinho-espumante-bruto",
    category: "vinhos",
    name: "Espumante Bruto Reserva Método Clássico",
    subtitle: "Arinto & Baga · 24 Meses em Cave",
    specs: "750 ml · 12.0% Vol · Bolha Fina",
    price: 22.00,
    badge: "Reserva Especial",
    image: `${b}assets/products/Espumante-2020.jpeg`,
    description: "Bolha finíssima, aroma de brioche tostado, maçã assada e noz. Cremoso, envolvente e requintado."
  },
  {
    id: "vinho-escolha-tinto",
    category: "vinhos",
    name: "Monte da Colónia Escolha Tinto 2023",
    subtitle: "Trincadeira, Aragonez & Alicante Bouschet",
    specs: "750 ml · 14.0% Vol · Tradição Alentejana",
    price: 14.50,
    badge: "Clássico",
    image: `${b}assets/products/Escolha2023.jpeg`,
    description: "Perfil clássico alentejano com fruta madura e especiaria doce. Taninos redondos e boa estrutura gastronómica."
  },
  {
    id: "vinho-syrah-petit-verdot",
    category: "vinhos",
    name: "Syrah & Petit Verdot 2023",
    subtitle: "Edição Especial de Castas Estrangeiras",
    specs: "750 ml · 14.5% Vol · Estágio em Carvalho",
    price: 16.00,
    badge: "Edição Limitada",
    image: `${b}assets/products/syrah-e-petit-verdot-2023-scaled.jpg`,
    description: "Vinho encorpado e sedutor, com notas de pimenta preta, amoras e cacau. Potencial de guarda extraordinário."
  },
  {
    id: "vinho-cabernet-sauvignon",
    category: "vinhos",
    name: "Cabernet Sauvignon 2023",
    subtitle: "Monocasta de Solos de Xisto",
    specs: "750 ml · 14.0% Vol · 10 Meses Barrica",
    price: 17.50,
    badge: "Monocasta",
    image: `${b}assets/products/Cabernet-Sauvignon-2023-scaled.jpg`,
    description: "Intensidade aromática de cassis, pimento verde maduro e cedro. Estrutura tânica aristocrática."
  },
  {
    id: "vinho-fernao-pires",
    category: "vinhos",
    name: "Fernão Pires Monovarietal 2024",
    subtitle: "Colheita Fresca da Vinha Nova",
    specs: "750 ml · 12.5% Vol · Cuba de Inox",
    price: 10.50,
    badge: "Aromático",
    image: `${b}assets/products/Fernao-Pires-2024.jpeg`,
    description: "Exuberância floral de jasmim e tília, paladar macio e envolvente com final frutado e ligeiramente especiado."
  },

  // AZEITES & GOURMET
  {
    id: "azeite-bio-500ml",
    category: "azeites",
    name: "Azeite Virgem Extra Biológico 500ml",
    subtitle: "Galega e Cobrançosa · Acidez < 0.18%",
    specs: "500 ml · Vidro Escuro UV · Extração a Frio",
    price: 8.90,
    badge: "Biológico",
    image: `${b}assets/products/0000427_azeite-virgem-extra-bio-500ml_300.png`,
    description: "Frutado verde médio, aroma a folha de oliveira e maçã verde. Amargo e picante nobres e equilibrados."
  },
  {
    id: "azeite-gourmet-250ml",
    category: "azeites",
    name: "Azeite Virgem Extra Gourmet 250ml",
    subtitle: "Galega Centenária de Colheita Precoce",
    specs: "250 ml · Galheteiro Luxo · Acidez < 0.15%",
    price: 6.50,
    badge: "Gourmet",
    image: `${b}assets/products/azeite-virgem-extra-250ml.png`,
    description: "Edição de colheita na aurora. Denso e complexo, com notas de rama de tomateiro e amêndoa verde."
  },
  {
    id: "azeite-familiar-2l",
    category: "azeites",
    name: "Azeite Virgem Extra Familiar 2 Litros",
    subtitle: "Extraído a Frio no Lagar da Herdade",
    specs: "2 L · Galão Prático com Vertedor",
    price: 22.00,
    badge: "Familiar",
    image: `${b}assets/products/0000430_azeite-virgem-extra-2l_300.png`,
    description: "Ideal para uso doméstico frequente. Equilibrado, frutado maduro suave e de elevadíssimo valor nutricional."
  },
  {
    id: "azeite-familiar-5l",
    category: "azeites",
    name: "Azeite Virgem Extra Tradicional 5 Litros",
    subtitle: "Garrafão Familiar Direto do Lagar",
    specs: "5 L · Embalagem Económica Herdade",
    price: 48.00,
    badge: "Melhor Valor",
    image: `${b}assets/products/0000432_azeite-virgem-extra-5l_300.png`,
    description: "O verdadeiro azeite das famílias alentejanas. Sabor autêntico, redondo e generoso para todas as confeções."
  },
  {
    id: "azeitonas-mistas-800g",
    category: "azeites",
    name: "Azeitonas Mistas Temperadas 800g",
    subtitle: "Com Orégãos Silvestres e Alho",
    specs: "800 g líquido · Salmoura Tradicional",
    price: 5.80,
    badge: "Receita Familiar",
