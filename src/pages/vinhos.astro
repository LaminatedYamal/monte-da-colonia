---
const target = `${import.meta.env.BASE_URL}produtos#vinhos`;
return Astro.redirect(target, 301);
---
<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="UTF-8">
  <meta http-equiv="refresh" content={`0;url=${target}`}>
  <title>Redirecionando para Os Nossos Produtos | Monte da Colónia</title>
  <script define:vars={{ target }}>window.location.replace(target);</script>
</head>
<body style="background-color: #14100D; color: #F3D08A; font-family: sans-serif; display: flex; align-items: center; justify-content: center; height: 100vh; margin: 0;">
  <p>A carregar <a href={target} style="color: #F3D08A;">Os Nossos Produtos &rarr; Vinhos</a>...</p>
</body>
</html>
