<!-- CLIENT SCRIPT FOR MOBILE CAROUSELS (USER INPUT ONLY - NO AUTO-PLAY) -->
<script>
  function setupMonteCarousels() {
    // 1. Identidade Carousel (4 Pilares)
    const idTrack = document.getElementById('identidade-track');
    const idDots = document.querySelectorAll('.identidade-dot');
    const idPrev = document.getElementById('identidade-prev');
    const idNext = document.getElementById('identidade-next');

    if (idTrack && idDots.length > 0) {
      const idCards = Array.from(idTrack.children) as HTMLElement[];

      function updateIdDots() {
        if (!idTrack) return;
        const scrollLeft = idTrack.scrollLeft;
        const trackCenter = scrollLeft + idTrack.clientWidth / 2;
        let closestIdx = 0;
        let minDiff = Infinity;

        idCards.forEach((card, idx) => {
          const cardCenter = card.offsetLeft + card.offsetWidth / 2;
          const diff = Math.abs(trackCenter - cardCenter);
          if (diff < minDiff) {
            minDiff = diff;
            closestIdx = idx;
          }
        });

        idDots.forEach((dot, idx) => {
          if (idx === closestIdx) {
            dot.classList.remove('bg-stone-300', 'w-2');
            dot.classList.add('bg-[#C5A059]', 'w-6');
          } else {
            dot.classList.remove('bg-[#C5A059]', 'w-6');
            dot.classList.add('bg-stone-300', 'w-2');
          }
        });
      }

      idDots.forEach((dot) => {
        dot.addEventListener('click', () => {
          const idx = parseInt(dot.getAttribute('data-index') || '0', 10);
          const card = idCards[idx];
          if (card && idTrack) {
            const targetLeft = card.offsetLeft - (idTrack.clientWidth - card.offsetWidth) / 2;
            idTrack.scrollTo({ left: targetLeft, behavior: 'smooth' });
          }
        });
      });

      if (idPrev) {
        idPrev.addEventListener('click', () => {
          const cardWidth = idCards[0]?.offsetWidth || 300;
          idTrack.scrollBy({ left: -(cardWidth + 24), behavior: 'smooth' });
        });
      }

      if (idNext) {
        idNext.addEventListener('click', () => {
          const cardWidth = idCards[0]?.offsetWidth || 300;
          idTrack.scrollBy({ left: (cardWidth + 24), behavior: 'smooth' });
        });
      }

      idTrack.addEventListener('scroll', () => {
        window.requestAnimationFrame(updateIdDots);
      }, { passive: true });
    }

    // 2. Galeria Carousel (6 Imagens)
    const galTrack = document.getElementById('galeria-track');
    const galDots = document.querySelectorAll('.galeria-dot');
    const galPrev = document.getElementById('galeria-prev');
    const galNext = document.getElementById('galeria-next');

    if (galTrack && galDots.length > 0) {
      const galCards = Array.from(galTrack.children) as HTMLElement[];

      function updateGalDots() {
        if (!galTrack) return;
        const scrollLeft = galTrack.scrollLeft;
        const trackCenter = scrollLeft + galTrack.clientWidth / 2;
        let closestIdx = 0;
        let minDiff = Infinity;

        galCards.forEach((card, idx) => {
          const cardCenter = card.offsetLeft + card.offsetWidth / 2;
          const diff = Math.abs(trackCenter - cardCenter);
          if (diff < minDiff) {
            minDiff = diff;
            closestIdx = idx;
          }
        });

        galDots.forEach((dot, idx) => {
          if (idx === closestIdx) {
            dot.classList.remove('bg-stone-300', 'w-2');
            dot.classList.add('bg-[#C5A059]', 'w-6');
          } else {
            dot.classList.remove('bg-[#C5A059]', 'w-6');
            dot.classList.add('bg-stone-300', 'w-2');
          }
        });
      }

      galDots.forEach((dot) => {
        dot.addEventListener('click', () => {
          const idx = parseInt(dot.getAttribute('data-index') || '0', 10);
          const card = galCards[idx];
          if (card && galTrack) {
            const targetLeft = card.offsetLeft - (galTrack.clientWidth - card.offsetWidth) / 2;
            galTrack.scrollTo({ left: targetLeft, behavior: 'smooth' });
          }
        });
      });

      if (galPrev) {
        galPrev.addEventListener('click', () => {
          const cardWidth = galCards[0]?.offsetWidth || 300;
          galTrack.scrollBy({ left: -(cardWidth + 16), behavior: 'smooth' });
        });
      }

      if (galNext) {
        galNext.addEventListener('click', () => {
          const cardWidth = galCards[0]?.offsetWidth || 300;
          galTrack.scrollBy({ left: (cardWidth + 16), behavior: 'smooth' });
        });
      }

      galTrack.addEventListener('scroll', () => {
        window.requestAnimationFrame(updateGalDots);
      }, { passive: true });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupMonteCarousels);
  } else {
    setupMonteCarousels();
  }
</script>

