  <script>
    function setupOilCarousel() {
      let currentOilSlide = 0;
      const track = document.getElementById('oil-slides-track');
      const tabs = document.querySelectorAll('.oil-tab');
      const dots = document.querySelectorAll('.oil-dot');
      const prevBtns = document.querySelectorAll('.oil-prev-btn');
      const nextBtns = document.querySelectorAll('.oil-next-btn');

      function goToOilSlide(idx: number) {
        currentOilSlide = idx;
        if (track) {
          track.style.transform = `translateX(-${idx * 100}%)`;
        }
        // Update tabs
        tabs.forEach((tab, i) => {
          if (i === idx) {
            tab.classList.remove('bg-stone-100/90', 'text-stone-700', 'border-[#C5A059]/40');
            tab.classList.add('bg-[#C5A059]', 'text-stone-950', 'border-[#C5A059]', 'shadow-md');
          } else {
            tab.classList.remove('bg-[#C5A059]', 'text-stone-950', 'border-[#C5A059]', 'shadow-md');
            tab.classList.add('bg-stone-100/90', 'text-stone-700', 'border-[#C5A059]/40');
          }
        });
        // Update dots
        dots.forEach((dot, i) => {
          if (i === idx) {
            dot.classList.remove('bg-stone-300');
            dot.classList.add('bg-[#C5A059]');
          } else {
            dot.classList.remove('bg-[#C5A059]');
            dot.classList.add('bg-stone-300');
          }
        });
      }

      tabs.forEach((tab) => {
        tab.addEventListener('click', () => {
          const idx = parseInt(tab.getAttribute('data-slide') || '0', 10);
          goToOilSlide(idx);
        });
      });

      dots.forEach((dot) => {
        dot.addEventListener('click', () => {
          const idx = parseInt(dot.getAttribute('data-slide') || '0', 10);
          goToOilSlide(idx);
        });
      });

      prevBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const newIdx = currentOilSlide === 0 ? 1 : 0;
          goToOilSlide(newIdx);
        });
      });

      nextBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const newIdx = currentOilSlide === 1 ? 0 : 1;
          goToOilSlide(newIdx);
        });
      });

      // Touch swipe
      const carouselEl = document.getElementById('oil-carousel');
      if (carouselEl) {
        let touchStartX = 0;
        carouselEl.addEventListener('touchstart', (e: TouchEvent) => {
          touchStartX = e.changedTouches[0].screenX;
        }, { passive: true });
        carouselEl.addEventListener('touchend', (e: TouchEvent) => {
          const touchEndX = e.changedTouches[0].screenX;
          if (touchStartX - touchEndX > 45) {
            goToOilSlide(1);
          } else if (touchEndX - touchStartX > 45) {
            goToOilSlide(0);
          }
        }, { passive: true });
      }
    }

    function setupWineCarousel() {
      let currentWineSlide = 0;
      const totalSlides = 4;
      const track = document.getElementById('wine-slides-track');
      const tabs = document.querySelectorAll('.wine-tab');
      const dots = document.querySelectorAll('.wine-dot');
      const prevBtns = document.querySelectorAll('.wine-prev-btn');
      const nextBtns = document.querySelectorAll('.wine-next-btn');

      function goToWineSlide(idx: number) {
        currentWineSlide = idx;
        if (track) {
          track.style.transform = `translateX(-${idx * 100}%)`;
        }
        // Update tabs
        tabs.forEach((tab, i) => {
          if (i === idx) {
            tab.classList.remove('bg-stone-100/90', 'text-stone-700', 'border-[#C5A059]/40');
            tab.classList.add('bg-[#C5A059]', 'text-stone-950', 'border-[#C5A059]', 'shadow-md');
          } else {
            tab.classList.remove('bg-[#C5A059]', 'text-stone-950', 'border-[#C5A059]', 'shadow-md');
            tab.classList.add('bg-stone-100/90', 'text-stone-700', 'border-[#C5A059]/40');
          }
        });
        // Update dots
        dots.forEach((dot, i) => {
          if (i === idx) {
            dot.classList.remove('bg-stone-300');
            dot.classList.add('bg-[#C5A059]');
          } else {
            dot.classList.remove('bg-[#C5A059]');
            dot.classList.add('bg-stone-300');
          }
        });
      }

      tabs.forEach((tab) => {
        tab.addEventListener('click', () => {
          const idx = parseInt(tab.getAttribute('data-slide') || '0', 10);
          goToWineSlide(idx);
        });
      });

      dots.forEach((dot) => {
        dot.addEventListener('click', () => {
          const idx = parseInt(dot.getAttribute('data-slide') || '0', 10);
          goToWineSlide(idx);
        });
      });

      prevBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const newIdx = currentWineSlide === 0 ? totalSlides - 1 : currentWineSlide - 1;
          goToWineSlide(newIdx);
        });
      });

      nextBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const newIdx = currentWineSlide === totalSlides - 1 ? 0 : currentWineSlide + 1;
          goToWineSlide(newIdx);
        });
      });

      // Touch swipe
      const carouselEl = document.getElementById('wine-carousel');
      if (carouselEl) {
        let touchStartX = 0;
        carouselEl.addEventListener('touchstart', (e: TouchEvent) => {
          touchStartX = e.changedTouches[0].screenX;
        }, { passive: true });
        carouselEl.addEventListener('touchend', (e: TouchEvent) => {
          const touchEndX = e.changedTouches[0].screenX;
          if (touchStartX - touchEndX > 45) {
            goToWineSlide(currentWineSlide === totalSlides - 1 ? 0 : currentWineSlide + 1);
          } else if (touchEndX - touchStartX > 45) {
            goToWineSlide(currentWineSlide === 0 ? totalSlides - 1 : currentWineSlide - 1);
          }
        }, { passive: true });
      }
    }

    function initCarousels() {
      setupWineCarousel();
      setupOilCarousel();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initCarousels);
    } else {
      initCarousels();
    }
  </script>

  <!-- FOOTER -->
  <Footer currentPage="produtos" />
</Layout>
